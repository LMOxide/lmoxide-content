{
  "$defs": {
    "LootBundle": {
      "additionalProperties": false,
      "description": "What one loot entry gives; every part optional.",
      "properties": {
        "chest": {
          "description": "One of these chests (`item/...`).",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-lmoxide-ref": ["item"]
        },
        "hearts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "description": "Health orbs."
        },
        "items": {
          "description": "These items (mission items, star bundles, ...).",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-lmoxide-ref": ["item"]
        },
        "minifig_bags": {
          "anyOf": [
            {
              "$ref": "#/$defs/MinifigureDrop"
            },
            {
              "type": "null"
            }
          ]
        },
        "minifig_parts": {
          "anyOf": [
            {
              "$ref": "#/$defs/MinifigureDrop"
            },
            {
              "type": "null"
            }
          ]
        },
        "potions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ]
        },
        "stars": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ]
        },
        "table": {
          "description": "Another table rolled too.",
          "type": ["string", "null"],
          "x-lmoxide-ref": ["loot"]
        }
      },
      "type": "object"
    },
    "LootEntry": {
      "additionalProperties": false,
      "properties": {
        "chance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ratio"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rolled on its own with this chance (`always` when neither this nor `weight`)."
        },
        "comment": {
          "type": "string"
        },
        "drop": {
          "$ref": "#/$defs/LootBundle"
        },
        "power_tier": {
          "description": "The client's `PowerTier` of what it drops (1000 health orb ... 4000 Super Chests, 5000\nminifigure parts): a roll at a lower loot power can skip it (tunables\n`loot.power.tier_window`).",
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "weight": {
          "description": "Or: one of the weighted entries is picked per roll.",
          "format": "uint32",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/LootWhen"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["drop"],
      "type": "object"
    },
    "LootWhen": {
      "additionalProperties": false,
      "properties": {
        "bonus_stat": {
          "description": "Raised by this buff's `orb_chance` (Resourceful).",
          "type": ["string", "null"]
        },
        "members_only": {
          "type": "boolean"
        },
        "once_per_player": {
          "type": "boolean"
        },
        "worlds": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-lmoxide-ref": ["world"]
        }
      },
      "type": "object"
    },
    "MinifigureDrop": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "$ref": "#/$defs/Range",
          "default": 1
        },
        "from": {
          "$ref": "#/$defs/MinifigureSource"
        }
      },
      "required": ["from"],
      "type": "object"
    },
    "MinifigureSource": {
      "anyOf": [
        {
          "description": "`\"world\"`: the minifigures of the world it drops in, by rarity.",
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-lmoxide-ref": ["minifig"]
        }
      ],
      "description": "Minifigure parts or bags: from these minifigures, or from what the world drops."
    },
    "Range": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      ],
      "description": "A number, or [min, max]",
      "x-lmoxide-unit": "range"
    },
    "Ratio": {
      "anyOf": [
        {
          "pattern": "^\\s*-?[0-9.]+\\s*%\\s*$",
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "A share: \"20%\" or a fraction (0.2)",
      "x-lmoxide-unit": "ratio"
    },
    "Source": {
      "description": "Where a value came from, so guesses stay visible next to what live did.",
      "oneOf": [
        {
          "const": "client",
          "description": "Extracted from the game client's data.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "Seen in a capture of the live server (LMO_Captures.cap).",
          "type": "string"
        },
        {
          "const": "demo",
          "description": "Seen in the recorded 2015 demo session.",
          "type": "string"
        },
        {
          "const": "footage",
          "description": "Taken from video footage of live.",
          "type": "string"
        },
        {
          "const": "server",
          "description": "Values the server used before they were moved into content (docs/TUNABLES.md).",
          "type": "string"
        },
        {
          "const": "proposed",
          "description": "Proposed by a tool from client data (navmesh, names, ...), not seen live.",
          "type": "string"
        },
        {
          "const": "surveyed",
          "description": "Placed or confirmed by someone in the world editor.",
          "type": "string"
        },
        {
          "const": "guess",
          "description": "A plain guess.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A loot table (several enemies or objects can share one): `loot/<slug>.json`.",
  "properties": {
    "author": {
      "type": "string"
    },
    "client_table": {
      "description": "The client loot table id the server scripts name (`engine.gethashfromloot(id, ...)`);\nits contents were server data.",
      "format": "uint32",
      "minimum": 0,
      "type": ["integer", "null"]
    },
    "comment": {
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/LootEntry"
      },
      "type": "array"
    },
    "extends": {
      "description": "Another record of the same kind this one starts from: its fields, then this one's on top.",
      "type": ["string", "null"],
      "x-lmoxide-ref": ["loot"]
    },
    "feature": {
      "description": "The feature it belongs to: `live` (recreating live), `feature/...` or `other/...`.\nA record with the id of one in a parent feature changes it while this feature is on.",
      "type": "string"
    },
    "id": {
      "description": "Its id: `loot/<slug>`. Stable: other records refer to it.",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "rev": {
      "description": "Revision, raised by every saved edit (for merging concurrent edits).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "rolls": {
      "default": 1,
      "description": "How many times the weighted entries are rolled.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "description": "Labels for sorting work out (\"approximate\", \"todo\", \"verified\", ...).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "updated": {
      "description": "Unix time of the last edit.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": ["id", "entries"],
  "title": "LootTable",
  "type": "object"
}
