{
  "$defs": {
    "Combat": {
      "additionalProperties": false,
      "properties": {
        "health_per_level": {
          "format": "float",
          "type": "number"
        },
        "level": {
          "description": "Players' level (all minifigures fight at this level without --progression).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "power_rating_all": {
          "format": "float",
          "type": "number"
        },
        "star_factor": {
          "format": "float",
          "type": "number"
        },
        "this_attack": {
          "$ref": "#/$defs/Duration",
          "description": "How long \"this attack\" lasts for procs that change an attack's hits (an area attack\nhits several enemies): Berserker's strike, Knockback."
        },
        "variance": {
          "$ref": "#/$defs/Ratio",
          "description": "Damage varies by this share either way."
        }
      },
      "required": ["level", "health_per_level", "star_factor", "power_rating_all", "variance", "this_attack"],
      "type": "object"
    },
    "Duration": {
      "anyOf": [
        {
          "pattern": "^\\s*-?[0-9.]+\\s*(ms|s|m|h)?\\s*$",
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "A length of time: \"1.5s\", \"200ms\", \"2m\", \"1h\", or a number of seconds",
      "x-lmoxide-unit": "duration"
    },
    "Loot": {
      "additionalProperties": false,
      "properties": {
        "bag_dynel_type": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "bag_interaction_radius": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "bag_lifetime": {
          "$ref": "#/$defs/Duration"
        },
        "bag_public_after": {
          "$ref": "#/$defs/Duration",
          "description": "A bag nobody has looted from opens to every player after this long."
        },
        "bag_template": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "items": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Items the loot rules name (`star`, `health_orb`, `potion`, `stars_25`, ...).",
          "type": "object"
        },
        "share_range": {
          "description": "Teammates within this distance of a kill get their own bag (m).",
          "format": "float",
          "type": "number"
        },
        "tables": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Which loot table each source rolls (`smashable`, `enemy`, `champion`, `boss`, `chest`,\n`member_chest`).",
          "type": "object"
        }
      },
      "required": [
        "share_range",
        "bag_lifetime",
        "bag_public_after",
        "bag_template",
        "bag_dynel_type",
        "bag_interaction_radius",
        "tables",
        "items"
      ],
      "type": "object"
    },
    "LostCreations": {
      "additionalProperties": false,
      "description": "The Lost Creations: how a run goes (docs/LOST-CREATIONS.md).",
      "properties": {
        "button_arrow_buff": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "button_effect": {
          "description": "The effect package played on the button when the countdown starts.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cant_equip_buff": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cant_resurrect_buff": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "continue_time": {
          "$ref": "#/$defs/Duration",
          "description": "How long a player at the exit door has to answer Continue / End Run (no answer: End Run)."
        },
        "element_block": {
          "description": "The run's element changes every this many levels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "enemy_loot": {
          "description": "What enemies drop inside a run (hearts only; smashables drop as anywhere).",
          "type": "string",
          "x-lmoxide-ref": ["loot"]
        },
        "entry_door": {
          "description": "The door that opens the \"Lost Creations\" window (door guid, in `entry_world`).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "entry_world": {
          "type": "string",
          "x-lmoxide-ref": ["world"]
        },
        "force_level": {
          "description": "For testing: every level is this one (`lc/...`), the Gatekeeper's too (unset: any).",
          "type": ["string", "null"],
          "x-lmoxide-ref": ["lc"]
        },
        "gatekeeper_every": {
          "description": "Every this many levels the Gatekeeper's level comes (5, 10, ...), and only then.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "invitation_time": {
          "$ref": "#/$defs/Duration",
          "description": "How long teammates have to answer the invitation (no answer: as Cancel)."
        },
        "level_time": {
          "$ref": "#/$defs/Duration",
          "description": "How long a level runs (the timer)."
        },
        "levels_per_pool": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "parts_per_pool": {
          "description": "Parts per unlocked pool: from, to (each a part of either minifigure of the pool).",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "requirement_quest": {
          "description": "The quest (hash) the entry window requires, \"Proved your strength at the Gauntlet\" (the\nclient checks the journal; every story quest is in it).",
          "type": "string"
        },
        "reward_chest": {
          "description": "The chest a player's rewards come in: it drops where it stands when they walk into the\nTreasure Chamber's `BA_TriggerDropLoot`; opening it drops the parts.",
          "type": "string",
          "x-lmoxide-ref": ["item"]
        },
        "reward_chest_pos": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "reward_pools": {
          "description": "The reward pools, lowest first (`minifig/...`): one more is unlocked every\n`levels_per_pool` levels completed.",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array",
          "x-lmoxide-ref": ["minifig"]
        },
        "smashed_delay": {
          "$ref": "#/$defs/Duration",
          "description": "After the whole team of a player is smashed, before they go to the Treasure Chamber (the\n\"You were smashed!\" splash)."
        },
        "timer_buff": {
          "description": "The client's buffs: the level timer (the HUD's clock), no equipping, no rebuilds; the\nstart button's arrow.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "treasure_arrival": {
          "$ref": "#/$defs/Point"
        },
        "treasure_chamber": {
          "description": "Where players go when their run ends.",
          "type": "string",
          "x-lmoxide-ref": ["world"]
        },
        "warmup": {
          "$ref": "#/$defs/Duration",
          "description": "The countdown after Start, before the start gate opens."
        }
      },
      "required": [
        "entry_door",
        "entry_world",
        "level_time",
        "warmup",
        "invitation_time",
        "continue_time",
        "smashed_delay",
        "gatekeeper_every",
        "element_block",
        "treasure_chamber",
        "treasure_arrival",
        "reward_chest",
        "reward_chest_pos",
        "enemy_loot",
        "reward_pools",
        "levels_per_pool",
        "parts_per_pool",
        "timer_buff",
        "cant_equip_buff",
        "cant_resurrect_buff",
        "button_arrow_buff",
        "button_effect"
      ],
      "type": "object"
    },
    "NpcLife": {
      "additionalProperties": false,
      "description": "NPC life on the live server: life = base[level] x the template's life factor.",
      "properties": {
        "base": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "interpolation": {
          "type": "string"
        }
      },
      "required": ["interpolation", "base"],
      "type": "object"
    },
    "NpcTunables": {
      "additionalProperties": false,
      "properties": {
        "regen_delay": {
          "$ref": "#/$defs/Duration",
          "description": "Out of combat this long after the last hit taken, enemy attack or damage dealt to an\nenemy before health comes back at `regen_share`."
        },
        "regen_share": {
          "$ref": "#/$defs/Ratio",
          "description": "Share of maximum health per tick out of combat (rounded down)."
        },
        "regen_share_in_combat": {
          "$ref": "#/$defs/Ratio",
          "description": "Share of maximum health per tick in combat (rounded down)."
        },
        "regen_tick": {
          "$ref": "#/$defs/Duration"
        }
      },
      "required": ["regen_delay", "regen_tick", "regen_share", "regen_share_in_combat"],
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A point with a facing.",
      "properties": {
        "pos": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "rot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["pos"],
      "type": "object"
    },
    "Progression": {
      "additionalProperties": false,
      "properties": {
        "minifigure_xp": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Minifigure rank -> stars needed.",
          "type": "object"
        },
        "rank_player_level": {
          "description": "Player level needed per minifigure rank.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": ["minifigure_xp", "rank_player_level"],
      "type": "object"
    },
    "Rarity": {
      "additionalProperties": false,
      "description": "How rare each minifigure's bag and parts are.",
      "properties": {
        "default": {
          "type": "string"
        },
        "part_locations": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Part location -> weight.",
          "type": "object"
        },
        "tiers": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Tier -> weight.",
          "type": "object"
        }
      },
      "required": ["tiers", "default", "part_locations"],
      "type": "object"
    },
    "Ratio": {
      "anyOf": [
        {
          "pattern": "^\\s*-?[0-9.]+\\s*%\\s*$",
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "A share: \"20%\" or a fraction (0.2)",
      "x-lmoxide-unit": "ratio"
    },
    "Rot": {
      "anyOf": [
        {
          "format": "float",
          "type": "number"
        },
        {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      ],
      "description": "Which way something faces: a heading (radians about the up axis) or a quaternion\n`[x, y, z, w]` as the client stores it."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`tunables.json`: every global number the server uses.",
  "properties": {
    "combat": {
      "$ref": "#/$defs/Combat"
    },
    "loot": {
      "$ref": "#/$defs/Loot"
    },
    "lost_creations": {
      "$ref": "#/$defs/LostCreations",
      "default": {
        "button_arrow_buff": 0,
        "button_effect": 0,
        "cant_equip_buff": 0,
        "cant_resurrect_buff": 0,
        "continue_time": "0s",
        "element_block": 0,
        "enemy_loot": "",
        "entry_door": 0,
        "entry_world": "",
        "gatekeeper_every": 0,
        "invitation_time": "0s",
        "level_time": "0s",
        "levels_per_pool": 0,
        "parts_per_pool": [0, 0],
        "reward_chest": "",
        "reward_chest_pos": [0.0, 0.0, 0.0],
        "reward_pools": [],
        "smashed_delay": "0s",
        "timer_buff": 0,
        "treasure_arrival": {
          "pos": [0.0, 0.0, 0.0]
        },
        "treasure_chamber": "",
        "warmup": "0s"
      },
      "description": "The Lost Creations runs (docs/LOST-CREATIONS.md; the levels are `lc` records)."
    },
    "minifigure_model": {
      "description": "The client's minifigure stat model (SimpleChar_t::CalculateLife, AttackUtils): tweaks,\nplayer defaults, formulas."
    },
    "more": {
      "additionalProperties": true,
      "description": "Anything else, by name (`section.name`).",
      "type": "object"
    },
    "npc": {
      "$ref": "#/$defs/NpcTunables"
    },
    "npc_life": {
      "$ref": "#/$defs/NpcLife"
    },
    "progression": {
      "$ref": "#/$defs/Progression"
    },
    "rarity": {
      "$ref": "#/$defs/Rarity"
    },
    "story_quests": {
      "additionalProperties": {
        "items": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "type": "array"
      },
      "description": "Main quest giver -> its quests, marked completed for everyone (the client's teleport\nwindows and map markers need them).",
      "type": "object"
    }
  },
  "required": ["combat", "loot", "npc", "progression", "npc_life", "rarity", "minifigure_model", "story_quests"],
  "title": "Tunables",
  "type": "object"
}
